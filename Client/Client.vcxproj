    </FxCompile>
    <FxCompile Include="Shaders\TerrainVS.hlsl">
      <ShaderType>Vertex</ShaderType>
    </FxCompile>
    <FxCompile Include="Shaders\WaterPS.hlsl">
      <ShaderType>Pixel</ShaderType>
    </FxCompile>
    <FxCompile Include="Shaders\WaterVS.hlsl">
      <ShaderType>Vertex</ShaderType>
    </FxCompile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Core.vcxproj">
      <Project>{73A1B550-9E49-4E36-9ED0-AECD1B53CFD6}</Project>
    </ProjectReference>
    <ProjectReference Include="..\Content\Content.vcxproj">
      <Project>{52F4AA12-E421-4D54-843F-8356EDEBD036}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
  <!--
    Neither dxc nor fxc creates the directory its /Fh names, and CompiledShaders\ is build output
    that is not in the tree (AGENTS.md §2), so the build makes it before the shaders compile.
  -->
  <Target Name="MakeCompiledShadersDirectory" AfterTargets="PrepareForBuild">
    <MakeDir Directories="$(ProjectDir)CompiledShaders" />
  </Target>
</Project>
