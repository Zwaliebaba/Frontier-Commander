    <RootNamespace>SimTests</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <!--
      NativeUnitTestProject makes Microsoft.Cpp.UnitTest.props put CppUnitTest.h and the
      framework's import library on the include and library paths, and marks the DLL as a test
      container vstest.console discovers (ADR-001).
    -->
    <ProjectSubType>NativeUnitTestProject</ProjectSubType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
