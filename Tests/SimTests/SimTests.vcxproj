<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Written by hand from the MSBuild schema (ADR-001; AGENTS.md §2, §3). Everything that is not
    about optimisation sits in the unconditional groups below and is therefore identical in
    Debug and Release by construction; the conditional groups hold only the differences
    AGENTS.md §3 enumerates. Build/CheckProjectFiles.py holds the projects to this shape.
  -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
